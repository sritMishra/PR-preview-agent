# ── PR Review Agent — environment template ─────────────────────────────
# Copy this file to `.env` (git-ignored) and fill in real values.
# Every new secret we add MUST be documented here (see CLAUDE.md §4).

# ── GitHub App (created in Settings → Developer settings → GitHub Apps) ──
# Numeric App ID shown on the App's settings page.
GITHUB_APP_ID=

# The App's private key (.pem you download once). Paste the FULL contents,
# newlines and all, wrapped in quotes. Example:
#   GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n"
GITHUB_PRIVATE_KEY=

# Random string you set on the App's "Webhook secret" field. Used to verify
# that incoming webhook payloads really came from GitHub.
GITHUB_WEBHOOK_SECRET=

# ── Anthropic (the review model) ───────────────────────────────────────
ANTHROPIC_API_KEY=
# Which Claude model reviews the code. Defaults to claude-opus-5 (most capable).
# Runs once per changed file, so model choice multiplies across a PR — set
# claude-sonnet-5 or claude-haiku-4-5 to trade review quality for cost.
ANTHROPIC_MODEL=

# ── Postgres (LangGraph checkpointer + Prisma run history) ─────────────
# e.g. postgresql://user:password@localhost:5432/pr_review_agent
DATABASE_URL=

# ── Server ─────────────────────────────────────────────────────────────
PORT=3000
